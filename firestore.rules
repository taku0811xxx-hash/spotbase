rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function requesterProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function sameOrg(data) {
      return isSignedIn() && requesterProfile().organizationId == data.organizationId;
    }

    function canView(data) {
      return sameOrg(data) &&
        (requesterProfile().accessLevel == "admin" || requesterProfile().category == data.category);
    }

    function isOwnOrgData(data) {
      return sameOrg(data) && requesterProfile().category == data.category;
    }

    match /users/{uid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || requesterProfile().organizationId == resource.data.organizationId);
      allow write: if false;
    }

    match /pins/{pinId} {
      allow read: if canView(resource.data);
      allow create: if isSignedIn() && isOwnOrgData(request.resource.data);
      allow update, delete: if canView(resource.data);
    }

    match /dispatch_records/{recordId} {
      allow read: if canView(resource.data);
      allow create: if isSignedIn() && isOwnOrgData(request.resource.data);
      allow update, delete: if canView(resource.data);
    }

    match /dispatches/{dispatchId} {
      allow read, write: if isSignedIn();
    }

    match /incidents/{incidentId} {
      // incidentsドキュメントには分類(category)フィールドが存在しないため、
      // canView/isOwnOrgData(分類一致を要求)を使うと一般ユーザーは常に
      // permission-deniedになってしまう。同組織の認証ユーザーであれば
      // 分類を問わず読み書きできるようにする。
      allow read: if sameOrg(resource.data);
      allow create: if isSignedIn() && sameOrg(request.resource.data);
      allow update, delete: if sameOrg(resource.data);
    }

    match /breaking_alerts/{alertId} {
      // 未確認速報ピン：パブリック情報として誰でも閲覧可能、書き込みはサーバー側のみ
      allow read: if true;
      allow write: if false;
    }

    match /user_locations/{uid} {
      // 自分の実機GPS移動経路: 本人のみ書き込み可能。閲覧は本人または同組織のみ
      // (他クルーの移動経路参照機能を将来追加する際の下地として同組織読み取りも許可)
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || requesterProfile().organizationId == resource.data.organizationId);
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /location_histories/{docId} {
      // 日付単位(YYYY-MM-DD)で蓄積される移動履歴ログ。ドキュメントIDは
      // `${uid}_${date}` で、本人のuidをdata.uidに保持する(lib/userPathHistory.ts
      // のsyncDailyLocationHistory参照)。GPSがOFF(user_locations側がisOnline:false)
      // になっても、こちらのログは消さずに保持する。
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.uid || requesterProfile().organizationId == resource.data.organizationId);
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if false;
    }
  }
}