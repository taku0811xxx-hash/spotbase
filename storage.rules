rules_version = '2';

// MVP段階の簡易ルール。招待コードでログインした人だけがアプリを使う前提だが、
// Firebase Authは未導入のため、現状は読み書きとも許可している。
// 本番運用する場合は、招待コードの検証をFirebase Auth(カスタムトークン等)に
// 置き換えたうえで、request.auth != null を条件に加えること。
service firebase.storage {
  match /b/{bucket}/o {
    match /pins/{pinId}/{allPaths=**} {
      allow read, write: if true;
    }
    match /dispatch_records/{recordId}/{allPaths=**} {
      allow read, write: if true;
    }
    match /photo_spots/{spotId}/{allPaths=**} {
      // 「ここトレ！」専用: 撮影スポット写真。誰でも閲覧可、投稿はサインイン必須。
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /photo_around/{allPaths=**} {
      // 周辺情報(駐車場・カフェ)に紐付く匿名の共有写真。誰でも閲覧可、投稿はサインイン必須。
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /photo_quick_memos/{uid}/{allPaths=**} {
      // 自分メモの非共有写真。本人のみ。
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
